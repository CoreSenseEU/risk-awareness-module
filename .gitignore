__pycache__
*.egg-info
.DS_Store
.venv/
ml_models
docs/proprietary
.claude/

# T3.3.7 feature cache — regenerated on demand; can grow large.
feature_cache/
# Experiment outputs — regenerated by scripts/run_experiments.py.
exp_results/
# Visual sanity outputs — regenerated by scripts/featextr_sandbox.py and scripts/test_run_with_video.py.
test_results/

# Datasets: raw bags and extracted frames are downloaded / regenerated, never committed.
# (Under ml_datasets/, only ground_truth_risk.json and split.json are repo content.)
ros_datasets/
ml_datasets/*/raw_dataset/
ml_datasets/*/features/
# Mocap ground-truth kinematics tables — regenerated by scripts/build_thor_magni_gt.py.
ml_datasets/*/gt/

# Private notes not to be committed
private/
# Re-encoded upload copies of the demo videos (attach to the GitHub release)
demo_videos/

# Model weights fetched on demand by ultralytics
*.pt
