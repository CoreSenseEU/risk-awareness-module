{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "bypassPermissions",
        "additionalDirectories": [],
        "deny": [
            "Edit(/**)",
            "Edit(~/**)",
            "Write(/**)",
            "Write(~/**)",
            "Read(/etc/**)",
            "Read(/root/**)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.gnupg/**)",
            "Read(~/.config/claude/**)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Bash(sudo *)",
            "Bash(su *)",
            "Bash(su)",
            "Bash(chmod 777 *)",
            "Bash(chown *)",
            "Bash(rm -rf /*)",
            "Bash(rm -rf ~*)",
            "Bash(rm -rf $HOME*)",
            "Bash(rm -rf ..*)",
            "Bash(rm -rf /)",
            "Bash(curl * | sh*)",
            "Bash(curl * | bash*)",
            "Bash(wget * | sh*)",
            "Bash(wget * | bash*)",
            "Bash(bash <(curl*)",
            "Bash(sh <(curl*)",
            "Bash(git commit*)",
            "Bash(git push*)",
            "Bash(git reset --hard*)",
            "Bash(git clean -f*)",
            "Bash(git clean -d*)",
            "Bash(git rebase*)",
            "Bash(git checkout -- *)",
            "Bash(npm install -g*)",
            "Bash(npm publish*)",
            "Bash(pip install --user*)",
            "Bash(pipx install*)",
            "Bash(systemctl*)",
            "Bash(service *)",
            "Bash(shutdown*)",
            "Bash(reboot*)",
            "Bash(kill -9 1*)"
        ],
        "allow": [
            "Edit(~/coresense/risk-awareness-module/**)",
            "Write(~/coresense/risk-awareness-module/**)",
            "Read(~/coresense/risk-awareness-module/**)",
            "Read(/usr/share/**)",
            "Read(/usr/lib/**)",
            "Read(/tmp/**)",
            "Bash(ls *)",
            "Bash(ls)",
            "Bash(pwd)",
            "Bash(cat *)",
            "Bash(head *)",
            "Bash(tail *)",
            "Bash(grep *)",
            "Bash(rg *)",
            "Bash(fd *)",
            "Bash(find *)",
            "Bash(tree*)",
            "Bash(wc *)",
            "Bash(stat *)",
            "Bash(file *)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git branch*)",
            "Bash(git blame*)",
            "Bash(git stash list*)",
            "Bash(git config --get*)",
            "Bash(python *)",
            "Bash(python3 *)",
            "Bash(pip install *)",
            "Bash(pip show *)",
            "Bash(pip list*)",
            "Bash(pytest*)",
            "Bash(ruff *)",
            "Bash(black *)",
            "Bash(mypy *)",
            "Bash(uv *)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(tsc*)",
            "Bash(pnpm *)",
            "Bash(yarn *)",
            "Bash(cargo *)",
            "Bash(rustc *)",
            "Bash(rustfmt *)",
            "Bash(clippy*)",
            "Bash(make *)",
            "Bash(mkdir *)",
            "Bash(touch *)",
            "Bash(cp *)",
            "Bash(mv *)",
            "Bash(diff *)",
            "Bash(echo *)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|Read|MultiEdit|NotebookEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-boundary.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}